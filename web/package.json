{
  "name": "tempo-chess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.selfhost.config.ts",
    "build": "vite build --config vite.selfhost.config.ts",
    "start": "cd .. && cargo run --release -- serve",
    "lint": "oxlint app components/*.tsx hooks lib selfhost",
    "format": "prettier --write app components/*.tsx hooks assets/*.json lib scripts tests selfhost index.html vite.selfhost.config.ts package.json tsconfig.json .oxlintrc.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format:check": "prettier --check app components/*.tsx hooks assets/*.json lib scripts tests selfhost index.html vite.selfhost.config.ts package.json tsconfig.json .oxlintrc.json",
    "build:rust": "node scripts/build-rust.mjs",
    "test:engine": "node --experimental-strip-types scripts/verify-engine.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@shadcn/react": "0.3.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "stockfish": "18.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
