# Production Compose interpolation. Copy this file to the server's
# ~/apps/tempo/.env and set your hostname. Deployments preserve this file.
# GitHub Actions writes the chosen image digest to tag.env separately.

# Hostname only, without https:// or a path.
TEMPO_DOMAIN=
# Optional existing Traefik middleware chain, e.g. auth@file,headers@docker.
TEMPO_TRAEFIK_MIDDLEWARES=
